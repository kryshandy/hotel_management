{
  "name": "hotel-management",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "check": "node --check server/index.js && node --check public/app.js",
    "test": "node --test server/test.js server/seed.test.js",
    "seed:apply": "node server/seed.js apply",
    "seed:remove": "node server/seed.js remove",
    "seed:snapshot": "node server/seed.js snapshot"
  }
}
